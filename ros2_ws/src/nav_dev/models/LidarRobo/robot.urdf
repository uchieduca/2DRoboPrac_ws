<?xml version="1.0"?>
<robot name="LidarRobo">
  <link name="base_footprint"/>

  <link name="base_link">
    <visual>
      <origin xyz="-0.064 0.08 0.06" rpy="0 0 -1.57"/>
      <geometry>
        <mesh filename="package://nav_dev/models/LidarRobo/meshes/2DRoboPrac.stl"/>
      </geometry>
      <material name="body">
        <color rgba="0.92 0.93 0.94 1"/>
      </material>
    </visual>
  </link>
  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>

  <link name="base_scan">
    <visual>
      <geometry>
        <cylinder radius="0.02" length="0.05"/>
      </geometry>
      <material name="lidar">
        <color rgba="0.15 0.16 0.16 1"/>
      </material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="base_scan"/>
    <origin xyz="0.15 0 0.06" rpy="0 0 0"/>
  </joint>

  <link name="wheel_left_link">
    <visual>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <material name="wheel_left">
        <color rgba="0.15 0.16 0.16 1"/>
      </material>
    </visual>
  </link>
  <joint name="wheel_left_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_left_link"/>
    <origin xyz="0 0.095 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="wheel_right_link">
    <visual>
      <geometry>
        <cylinder radius="0.033" length="0.018"/>
      </geometry>
      <material name="wheel_right">
        <color rgba="0.15 0.16 0.16 1"/>
      </material>
    </visual>
  </link>
  <joint name="wheel_right_joint" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_right_link"/>
    <origin xyz="0 -0.095 0.023" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="caster_back_right_link">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="caster_right">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>
  <joint name="caster_back_right_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_right_link"/>
    <origin xyz="0.15 -0.05 -0.004" rpy="-1.57 0 0"/>
  </joint>

  <link name="caster_back_left_link">
    <visual>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="caster_left">
        <color rgba="0 1 0 1"/>
      </material>
    </visual>
  </link>
  <joint name="caster_back_left_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_back_left_link"/>
    <origin xyz="0.15 0.05 -0.004" rpy="-1.57 0 0"/>
  </joint>
</robot>